<?xml version="1.0" encoding="utf-8"?>
<configuration>
<configSections>
</configSections>
<appSettings>
    <!-- FareSource: Csv 或 Postgres；Postgres 连接失败会自动回退 CSV -->
    <add key="FareSource" value="Postgres" />
    <add key="FareDb" value="Host=localhost;Port=5432;Database=bus;Username=postgres;Password=3313;Timeout=3;Command Timeout=5" />
</appSettings>
<connectionStrings>
    <add name="_125GateApp.Properties.Settings.ConnectionString"
        connectionString="Dsn=qbdcq;uid=sa" providerName="System.Data.Odbc" />
</connectionStrings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
